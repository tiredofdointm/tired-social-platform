{
  "name": "tired-social-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Independent social events and talent marketplace UI foundation",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "tsc --noEmit && node --check server.mjs && node --check scripts/build.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "build": "node scripts/build.mjs",
    "pretest": "npm run build"
  },
  "devDependencies": {
    "playwright": "1.56.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3",
    "esbuild": "0.25.11"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  }
}
